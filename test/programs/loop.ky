{ 'x 'y:
    ['x, 'y] -> - -->
    | 0 1 
    | '_ 0
    |> -> @
} -> q
q -~> eq

{ 'x 'y:

    { 'x 'y 'next:
        ['next, 'y] -> work
        ['x, 'y] -> eq -->
        | 1
             'y -> + --> @
        | '_
            'x -> + --> + -0>
            work --> @
        |>
    } ~> work

    { 'x 'y:
        ['x, 'y] -> @
        ['x, 1] -> - --> @
    } ~> work

    'x -> +
    ['x, 1] -> - --> work
    'y -> work --> @
} ~> f

